# Copy values into services/api/.env for local uvicorn.
# Docker Compose reads these from the shell or a root .env.

SHOP_PASSPHRASE=sample-shop
SHOP_PASSPHRASE_HINT=0
SHOP_ID=sample
SHOP_NAME=Sample fleet
DEMO_TOOLS=1
SHOP_LEAD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Railway: see docs/RAILWAY.md. Set these in the Railway UI, never in git.
# API_PROXY_URL=http://api.railway.internal:8000
# CORS_ORIGINS=https://your-web.up.railway.app

# Own VM + Caddy only. Set these on the server, never in git.
# ANODET_HOST=
# CORS_ORIGINS=https://your-host.example

# Optional. Server-side only. Do not add to the Next.js app.
# XAI_API_KEY=
# XAI_MODEL=grok-4
