# Shop sign-in. Default passphrase is sample-shop.
# Set your own value before anyone outside this machine signs in.
# The sign-in screen does not show the passphrase unless SHOP_PASSPHRASE_HINT=1.
SHOP_PASSPHRASE=sample-shop
SHOP_PASSPHRASE_HINT=0
SHOP_ID=sample
SHOP_NAME=Sample fleet

# Judge/demo wipe and seed buttons. Set 0 on a real shop.
DEMO_TOOLS=1

# Optional. This name is always shop lead. If empty, the first sign-in on a shop is lead.
# SHOP_LEAD=

# Optional. Case summary, procedure draft, column map, and manual split call Grok when set.
# Leave empty to use the template fallback. Never put this key in the browser.
# XAI_API_KEY=
# XAI_MODEL=grok-4
# XAI_DRAFT_MODEL=grok-4

# Optional. Defaults keep the NASA demo fleet on this machine.
# ANODET_DB=audit.db
# ANODET_DATA=../../data/cmapss/train_FD001.txt
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
