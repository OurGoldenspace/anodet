# Shop sign-in. The default passphrase is sample-shop and the sign-in screen shows it.
# Set SHOP_PASSPHRASE to your own value before anyone else opens the desk.
# SHOP_PASSPHRASE=sample-shop
# SHOP_PASSPHRASE_HINT=0

# Optional. The case summary calls Grok when this is set. Steps stay on the manual.
# XAI_API_KEY=
# XAI_MODEL=grok-4

# Optional. Defaults keep the sample fleet on this machine.
# ANODET_DB=audit.db
# ANODET_DATA=../../data/cmapss/train_FD001.txt
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
